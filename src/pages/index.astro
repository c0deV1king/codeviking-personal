---
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/png" href="/settings_button.png" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>HWNerd.net</title>
  </head>
  <body class="min-h-screen">
    <main class="flex flex-col items-center w-full px-4 py-8">
      <div class="w-full mx-auto flex flex-col">
        <Header />
        <div class="flex flex-row w-full justify-center gap-4 mt-8">
          <button class="bg-transparent hover:bg-[#e8871f] text-white border border-[#553B08] font-bold py-2 px-4 rounded">
            <a href="/blogs">Blogs</a>
          </button>
          <button class="bg-transparent hover:bg-[#e8871f] text-white border border-[#553B08] font-bold py-2 px-4 rounded">
            <a href="/links">Links</a>
          </button>
        </div>
      </div>
      <Footer />
    </main>
  </body>
</html>
