---
import { links } from "../../data/links";
---

<div class="flex justify-center mt-1 mb-8">
  <div class="flex flex-col p-0 w-[100%] sm:w-[50%]">
    <h1 class="text-5xl self-center sm:self-center mb-2 mt-2">links from the interwebs</h1>
    <ul class="space-y-0 self-center">
      {
        links.map((link) => (
          <li>
            <a href={link.link}>{link.title}</a>
          </li>
        ))
      }
    </ul>
  </div>
</div>